# This .gitignore file is for Visual Studio projects.
# It excludes files and directories that are generated by the build process,
# NuGet package manager, and other tools, which should not be
# committed to a Git repository.

## Ignore generated files and folders
# Visual Studio solution files
*.suo
*.sln.docstates
*.vssscc
*.vspscc

# Binaries
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
.bin/

# Test results
TestResults/
*.trx

# User-specific files
*.user
*.pdb
*.pidb
*.vshost.exe
*.vshost.exe.config
*.user.resharper
*.resharper.user
*.resharper.host
*.vs/
*.[Ss]u?o
*.sln.docstates

# NuGet packages
packages/
*.nupkg
.nuget/

# ASP.NET Core
/wwwroot/
/wwwroot/lib/
/wwwroot/dist/
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json
appsettings.json

# Rider
.idea/
.vs/
.Rider/
*.sln.DotSettings.user
*.sln.DotSettings

# Visual Studio Code
.vscode/

# Ignore project specific files
obj/
bin/
*.pdb
*.idb
*.mdb
*.user
*.bak
*.cache
*.ncb
*.scc
*.vs
[Tt]humbs.db